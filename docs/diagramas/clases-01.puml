@startuml clases-01
hide circle
skinparam classAttributeIconSize 0
'skinparam backgroundColor transparent
skinparam monochrome true
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12

' ====== SISTEMA ======
class Sistema {
    + ejecutar()
    - iniciarSesion() : Cuenta
    - menu(cuenta : Cuenta) : Boolean
    - crearCuenta()
    - borrarCuenta(cuenta : Cuenta)
    - nuevoMensaje(emisor : Usuario)
    - leerMensaje(receptor : Usuario)
    - verEnviados(emisor : Usuario)
}

' ====== CUENTAS ======
abstract class Cuenta {
    - nombreUsuario : String
    - contrasenia : String
    + comprobarUsuario(username : String, contrasenia : String) : Boolean
    + {abstract} obtenerOpciones() : String[]
    + {abstract} esUsuario() : Boolean
}

class Usuario {
    + obtenerOpciones() : String[]
    + esUsuario() : Boolean
}

class Admin {
    + obtenerOpciones() : String[]
    + esUsuario() : Boolean
}

Cuenta <|-- Usuario
Cuenta <|-- Admin

' ====== MENSAJE ======
class Mensaje {
    - asunto : String
    - cuerpo : String
    - fechaEnvio : Date
    - leido : Boolean
    + leer() : String
    + esPara(u : Usuario) : Boolean
    + esDe(u : Usuario) : Boolean
    + estaLeido() : Boolean
}

' ====== RELACIONES ======
Sistema *--> Cuenta
Mensaje <-* Sistema
Mensaje --> Usuario : emisor
Mensaje --> Usuario : receptor

@enduml
